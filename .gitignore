# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database (personal clan data) + active-DB pointer
/data/clash.db
/data/clash.db-*
/data/clash-test.db
/data/clash-test.db-*
/data/active-db.json

# design reference — heavy source material stays local; the card icons and
# member avatar PNGs are committed
Assets UI/gestal.gg_raid_screenshot_*.png
Assets UI/**/*.psd

# python bytecode (settings.json runs the Node hook twin, orchestrate-gate.js;
# orchestrate-gate.py is the shipped fallback runtime, kept but unused here)
__pycache__/
*.pyc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scaffold-owned paths (added by the scaffold updater)
# machine-specific Claude Code settings
.claude/settings.local.json
# rate-limit samples from the statusline sensor
.claude/budget-state.json
# backups written by the scaffold updater
.claude/update-backup/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database (personal clan data) + active-DB pointer
/data/clash.db
/data/clash.db-*
/data/clash-test.db
/data/clash-test.db-*
/data/active-db.json

# design reference — heavy source material stays local; the card icons and
# member avatar PNGs are committed
Assets UI/gestal.gg_raid_screenshot_*.png
Assets UI/**/*.psd

# python bytecode (the legacy .py hook is kept but unused; settings.json runs the .mjs)
__pycache__/
*.pyc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Optional. The app and scripts work with NO env file — they default to a local
# SQLite file at data/clash.db. Copy to .env.local only if you want to override.

# Local file (default):
# DATABASE_URL=file:data/clash.db

# To share online later via Turso (hosted libSQL) — no code changes needed:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Optional Google Sheet for the Sync flow.
# NEXT_PUBLIC_GOOGLE_SHEET_URL prefills the Sync field on the in-app /import page.
# GOOGLE_SHEET_URL is used by the CLI: npm run sync:sheet
# NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_ID/edit#gid=0
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_ID/edit#gid=0

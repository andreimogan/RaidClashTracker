# Copy to .env.local and fill in. Find values in Supabase → Project Settings → API.

# --- Public (used by the Next.js app in the browser; safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (used by local data scripts: seed / import / sync) ---
# NEVER expose this key in the app or commit it. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
